# Copia este archivo a `.env` y ajusta los valores.
# Para desarrollo local basta con dejarlo tal cual (usa SQLite).

DEBUG=True
SECRET_KEY=cambia-esta-clave-en-produccion

# Motor de base de datos: sqlite (default) | postgresql
DB_ENGINE=sqlite

# Solo necesarios si DB_ENGINE=postgresql
# DB_NAME=sgic_terneros
# DB_USER=mathuz
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

ALLOWED_HOST=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_HORAS=12
JWT_REFRESH_DIAS=7