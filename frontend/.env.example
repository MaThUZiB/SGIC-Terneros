# Modo de autenticación: django (legado) o supabase (migración gradual).
# Durante la migración, Supabase muestra un portal de acceso protegido;
# no se habilitan todavía los módulos CRUD de Django.
VITE_AUTH_PROVIDER=supabase

# Valores públicos de Supabase. Copiar desde Project Settings > API.
# NO utilizar service_role, secret keys ni claves de base de datos aquí.
VITE_SUPABASE_URL=https://rsqdtslkndgtaejkaoju.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo en modo Django local:
# VITE_AUTH_PROVIDER=django
# VITE_API_URL=http://127.0.0.1:8000/api
